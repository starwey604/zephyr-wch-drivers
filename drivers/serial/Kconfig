config WCH_UART
	bool "External WCH USART polling/interrupt baseline"
	depends on SERIAL
	depends on DT_HAS_WCH_USART_ENABLED
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select SERIAL_SUPPORT_ASYNC
	select PINCTRL
	help
	  Opt-in downstream copy of the community WCH USART driver, for
	  CH32V203 bring-up. Disable UART_WCH_USART explicitly to avoid two
	  drivers owning the same devicetree nodes. Polling and interrupt
	  APIs are present; experimental async TX is a separate opt-in option.
	  This driver has only been compile-tested, not hardware-validated.

config WCH_UART_DMA_PREPARE
	bool "Validate CH32V203 USART1/2 DMA resources (no transfers yet)"
	depends on WCH_UART && DMA
	help
	  Check tx/rx devicetree mappings and DMA controller readiness before
	  UART initialization. This does not reserve/start DMA channels or
	  select SERIAL_SUPPORT_ASYNC. It prepares the next development stage.

config WCH_UART_ASYNC_TX
	bool "Experimental CH32V203 asynchronous DMA TX (no async RX)"
	depends on WCH_UART && UART_ASYNC_API && DMA && WCH_DMA
	select WCH_UART_DMA_PREPARE
	help
	  Reserve USART1/2 TX and RX DMA channels and implement byte-wide TX,
	  abort and a software deadline. TX_DONE waits for USART TC. Async RX
	  returns ENOTSUP. Disable UART_INTERRUPT_DRIVEN and UART_WIDE_DATA:
	  mixed IRQ/async and wide data are not supported in this increment.
	  Not yet hardware-qualified. Do not use for production control buses.
