config WCH_UART
	bool "External WCH USART polling/interrupt baseline"
	depends on SERIAL
	depends on DT_HAS_WCH_USART_ENABLED
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select SERIAL_SUPPORT_ASYNC
	select PINCTRL
	help
	  Opt-in downstream copy of the community WCH USART driver, for
	  CH32V203 bring-up. Disable UART_WCH_USART explicitly to avoid two
	  drivers owning the same devicetree nodes. Polling and interrupt
	  APIs are present; experimental async TX is a separate opt-in option.
	  UART1 paced polling has been tested on one CH32V203F8U board.
	  Bounded dual IRQ echo passed at 115200; 921600 is not qualified.
	  Asynchronous modes still require hardware validation.

config WCH_UART_IRQ_TRACE
	bool "CH32V203 UART IRQ RAM flight recorder (diagnostic only)"
	depends on WCH_UART && UART_INTERRUPT_DRIVEN && !UART_ASYNC_API
	depends on SOC_CH32V203 && CH32V00X_SYSTICK && !SMP
	help
	  Record IRQ timing, existing status reads, and byte counts in RAM.
	  No printk, UART output, allocation or additional STATR/DATAR reads.
	  Timing is perturbed by instrumentation. Decode only after traffic;
	  the first observed hardware error freezes the event ring, not counters.

config WCH_UART_IRQ_TRACE_SLOW_US
	int "IRQ callback slow threshold in nominal microseconds"
	depends on WCH_UART_IRQ_TRACE
	range 1 1000
	default 8

config WCH_UART_IRQ_TRACE_SAMPLE_INTERVAL
	int "Time one in N IRQ callbacks (1 = intrusive full timing)"
	depends on WCH_UART_IRQ_TRACE
	range 1 65535
	default 127
	help
	  Error snapshots and byte counters remain enabled on every IRQ.
	  Full timing caused extra overruns during dual 921600 bring-up;
	  sampled timing reduces but does not eliminate observer overhead.
	  Prefer an odd interval to avoid always sampling TX in alternating
	  RX/TX interrupt traffic.

config WCH_UART_DMA_PREPARE
	bool "Validate CH32V203 USART1/2 DMA resources (no transfers yet)"
	depends on WCH_UART && DMA
	help
	  Check tx/rx devicetree mappings and DMA controller readiness before
	  UART initialization. This does not reserve/start DMA channels or
	  select SERIAL_SUPPORT_ASYNC. It prepares the next development stage.

config WCH_UART_ASYNC_TX
	bool "Experimental CH32V203 asynchronous DMA TX"
	depends on WCH_UART && UART_ASYNC_API && DMA && WCH_DMA
	select WCH_UART_DMA_PREPARE
	help
	  Reserve USART1/2 TX and RX DMA channels and implement byte-wide TX,
	  abort and a software deadline. TX_DONE waits for USART TC. Async RX
	  requires the separate WCH_UART_ASYNC_RX option. Disable
	  UART_INTERRUPT_DRIVEN and UART_WIDE_DATA:
	  mixed IRQ/async and wide data are not supported in this increment.
	  Not yet hardware-qualified. Do not use for production control buses.

config WCH_UART_ASYNC_RX
	bool "Experimental CH32V203 asynchronous DMA RX (no inactivity timeout)"
	depends on WCH_UART_ASYNC_TX
	help
	  Enable byte-wide RX with one current and one queued buffer, explicit
	  disable and UART/DMA error events. Only SYS_FOREVER_US is accepted;
	  finite inactivity timeout and IDLE handling await hardware validation.
	  Normal-mode DMA rearming has a gap: lossless continuous reception,
	  especially dual 3 Mbaud operation, is NOT yet qualified.
